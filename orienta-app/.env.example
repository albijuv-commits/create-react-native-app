# Indirizzo della web app di Orienta già pubblicata, senza la barra finale.
# L'app lo usa per le route server della web app, che tengono le chiavi: l'intervista con
# l'intelligenza artificiale (/api/triage), la ricerca dei medici (/api/medici, /api/luoghi) e il
# catalogo completo dei farmaci (/api/farmaci). Non è un segreto (finisce nell'app) e nessuna chiave
# va messa qui. Se resta vuoto l'app funziona lo stesso: l'intervista usa le regole fisse sul
# telefono, Medici e Mercato mostrano dati di esempio etichettati come tali.
# Copia questo file in .env.local e scrivi l'indirizzo.
EXPO_PUBLIC_API_URL=

# Titolare del trattamento e contatto per la privacy, mostrati nell'Informativa privacy dell'app.
# Vanno compilati da chi pubblica Orienta prima di distribuire la build; finché sono vuoti la pagina
# dice che mancano. Non inventarli.
EXPO_PUBLIC_PRIVACY_CONTROLLER=
EXPO_PUBLIC_PRIVACY_CONTACT=
