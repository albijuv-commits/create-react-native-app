# Copia questo file in .env.local e inserisci i valori.
# Nessuna di queste chiavi arriva mai al browser: sono lette solo dalle route server.

# Chiave per l'intervista sui sintomi con Claude (https://console.anthropic.com/).
# Se manca, l'intervista usa un motore a regole con domande fisse.
ANTHROPIC_API_KEY=

# Modello da usare per l'intervista. Default: claude-sonnet-5-5
CLAUDE_MODEL=claude-sonnet-5-5

# Facoltativa: Google Places API (Text Search) per cercare i medici.
# Se manca, si usa OpenStreetMap (Overpass) e, in ultima istanza, dati di esempio etichettati.
GOOGLE_PLACES_API_KEY=

# Indirizzo pubblico dell'app (per i link assoluti delle anteprime di condivisione).
# Per esempio https://www.example.com — in sviluppo si può lasciare vuoto.
NEXT_PUBLIC_SITE_URL=

# Facoltative, sezione Medici.
# Forza una fonte: google, osm oppure esempio (i test end-to-end usano esempio).
DOCTORS_PROVIDER=
# Istanze Overpass da provare in ordine, separate da virgole. Quella pubblica va bene per sviluppo
# e prove: per un uso reale serve un'istanza propria o a pagamento.
OVERPASS_URL=
# Servizio Nominatim per cercare città e CAP (default: quello pubblico di OpenStreetMap).
NOMINATIM_URL=
# Contatto da mettere nel User-Agent verso Overpass e Nominatim (un indirizzo web o un'email
# del gestore dell'app), come chiedono le loro regole d'uso. Se manca si usa NEXT_PUBLIC_SITE_URL.
OSM_CONTACT=

# Facoltative, sezione Mercato.
# Percorso del database dei medicinali creato con «npm run import:aifa» (default data/medicines/orienta.db).
MEDICINES_DB_PATH=
# «esempio» usa il campione di esempio anche se il database c'è (i test end-to-end lo usano).
MEDICINES_SOURCE=

# Da impostare prima di pubblicare l'app: si leggono durante la build e compaiono nell'informativa
# privacy (/profilo/privacy). Finché mancano, la pagina mostra «Da completare prima della pubblicazione».
# Titolare del trattamento: nome o ragione sociale e indirizzo.
PRIVACY_CONTROLLER=
# Contatto per la privacy e per esercitare i diritti: un'email o una pagina web.
PRIVACY_CONTACT=
